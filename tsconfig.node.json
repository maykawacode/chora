{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": [
    "electron.vite.config.*",
    "vite.web.config.*",
    "build/**/*",
    "src/main/**/*",
    "src/preload/**/*"
  ]
}
