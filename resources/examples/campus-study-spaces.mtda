    { "id": "40000000-0000-4000-8000-000000000002", "label": "Private–Social", "poleA": "Private", "poleB": "Social", "definition": "0 supports being alone and unobserved; 1 encourages interaction and shared presence.", "weight": 1, "categories": { "evaluative": false, "potency": false, "activity": false, "utility": false, "socialMeaning": true, "aesthetics": false } },
    { "id": "40000000-0000-4000-8000-000000000003", "label": "Structured–Flexible", "poleA": "Structured", "poleB": "Flexible", "definition": "0 has fixed rules and furniture; 1 allows people to adapt the setting and activity.", "weight": 1, "categories": { "evaluative": false, "potency": false, "activity": false, "utility": true, "socialMeaning": false, "aesthetics": false } },
    { "id": "40000000-0000-4000-8000-000000000004", "label": "Artificial–Natural", "poleA": "Artificial", "poleB": "Natural", "definition": "0 is dominated by built surfaces and electric light; 1 is dominated by plants, daylight, and outdoor conditions.", "weight": 1, "categories": { "evaluative": false, "potency": false, "activity": false, "utility": false, "socialMeaning": false, "aesthetics": true } },
    { "id": "40000000-0000-4000-8000-000000000005", "label": "Convenient–Out of the way", "poleA": "Convenient", "poleB": "Out of the way", "definition": "0 is easy to reach during a normal day; 1 requires a deliberate detour or special access.", "weight": 1, "categories": { "evaluative": false, "potency": false, "activity": false, "utility": true, "socialMeaning": false, "aesthetics": false } },
