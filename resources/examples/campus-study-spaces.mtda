{
  "version": "5.0",
  "sessionMeta": {
    "id": "10000000-0000-4000-8000-000000000001",
    "name": "Finding a place to study on campus",
    "definition": "A synthetic comparison of familiar campus study spaces. The scores are illustrative observations, not measurements from a particular institution."
  },
  "elements": [
    { "id": "20000000-0000-4000-8000-000000000001", "name": "Main library reading room", "definition": "A large, quiet room with individual tables and clear expectations of silent work.", "weight": 5, "color": "#65758b", "shape": "circle", "collectionIds": ["30000000-0000-4000-8000-000000000001"] },
    { "id": "20000000-0000-4000-8000-000000000002", "name": "Silent-floor carrel", "definition": "A screened single-person desk on a designated silent floor.", "weight": 2, "color": "#65758b", "shape": "circle", "collectionIds": ["30000000-0000-4000-8000-000000000001"] },
    { "id": "20000000-0000-4000-8000-000000000003", "name": "Law library", "definition": "A formal subject library with long tables, subdued conversation, and dense reference materials.", "weight": 4, "color": "#65758b", "shape": "circle", "collectionIds": ["30000000-0000-4000-8000-000000000001"] },
    { "id": "20000000-0000-4000-8000-000000000004", "name": "Archive reading room", "definition": "A supervised reading room designed for careful work with special collections.", "weight": 2, "color": "#65758b", "shape": "circle", "collectionIds": ["30000000-0000-4000-8000-000000000001"] },
    { "id": "20000000-0000-4000-8000-000000000005", "name": "Empty classroom", "definition": "An unused teaching room between classes, with desks, a board, and uncertain availability.", "weight": 3, "color": "#65758b", "shape": "circle", "collectionIds": ["30000000-0000-4000-8000-000000000001"] },
    { "id": "20000000-0000-4000-8000-000000000006", "name": "Window study nook", "definition": "A small window-side seat at the edge of a library corridor.", "weight": 1, "color": "#65758b", "shape": "circle", "collectionIds": ["30000000-0000-4000-8000-000000000001", "30000000-0000-4000-8000-000000000003"] },
    { "id": "20000000-0000-4000-8000-000000000007", "name": "Student union commons", "definition": "A busy open commons used for eating, meeting, waiting, and informal work.", "weight": 5, "color": "#b76845", "shape": "square", "collectionIds": ["30000000-0000-4000-8000-000000000002"] },
    { "id": "20000000-0000-4000-8000-000000000008", "name": "Group study room", "definition": "A reservable enclosed room with a shared table and display for team projects.", "weight": 4, "color": "#b76845", "shape": "square", "collectionIds": ["30000000-0000-4000-8000-000000000002"] },
    { "id": "20000000-0000-4000-8000-000000000009", "name": "Campus café", "definition": "A coffee shop where conversation, music, food service, and laptop work overlap.", "weight": 4, "color": "#b76845", "shape": "square", "collectionIds": ["30000000-0000-4000-8000-000000000002"] },
    { "id": "20000000-0000-4000-8000-000000000010", "name": "Design studio", "definition": "A project room with large work surfaces, shared tools, and visible work in progress.", "weight": 5, "color": "#b76845", "shape": "square", "collectionIds": ["30000000-0000-4000-8000-000000000002"] },
    { "id": "20000000-0000-4000-8000-000000000011", "name": "Residence hall lounge", "definition": "A casual shared living space with sofas, televisions, and frequent passersby.", "weight": 3, "color": "#b76845", "shape": "square", "collectionIds": ["30000000-0000-4000-8000-000000000002"] },
    { "id": "20000000-0000-4000-8000-000000000012", "name": "Outdoor courtyard table", "definition": "A central outdoor table where friends gather and short study sessions happen between activities.", "weight": 3, "color": "#b76845", "shape": "square", "collectionIds": ["30000000-0000-4000-8000-000000000002", "30000000-0000-4000-8000-000000000003"] },
    { "id": "20000000-0000-4000-8000-000000000013", "name": "Botanical garden bench", "definition": "A secluded bench among planted paths, used for reading, reflection, or a break.", "weight": 1, "color": "#66875a", "shape": "triangle", "collectionIds": ["30000000-0000-4000-8000-000000000003"] },
    { "id": "20000000-0000-4000-8000-000000000014", "name": "Museum atrium", "definition": "A daylit public interior with benches, intermittent visitors, and visual interest.", "weight": 3, "color": "#66875a", "shape": "triangle", "collectionIds": ["30000000-0000-4000-8000-000000000003"] },
    { "id": "20000000-0000-4000-8000-000000000015", "name": "Lakeside lawn", "definition": "An open grassy edge used for reading, resting, and informal gatherings in good weather.", "weight": 3, "color": "#66875a", "shape": "triangle", "collectionIds": ["30000000-0000-4000-8000-000000000003"] },
    { "id": "20000000-0000-4000-8000-000000000016", "name": "Chapel side room", "definition": "A small, calm room set apart from the main circulation of campus.", "weight": 1, "color": "#66875a", "shape": "triangle", "collectionIds": ["30000000-0000-4000-8000-000000000001", "30000000-0000-4000-8000-000000000003"] },
    { "id": "20000000-0000-4000-8000-000000000017", "name": "Shaded quad table", "definition": "A movable table under mature trees, close to paths but buffered from indoor activity.", "weight": 2, "color": "#66875a", "shape": "triangle", "collectionIds": ["30000000-0000-4000-8000-000000000003"] },
    { "id": "20000000-0000-4000-8000-000000000018", "name": "Greenhouse walkway", "definition": "A warm planted passage with occasional foot traffic and places to pause briefly.", "weight": 2, "color": "#66875a", "shape": "triangle", "collectionIds": ["30000000-0000-4000-8000-000000000003"] }
  ],
  "collections": [
    { "id": "30000000-0000-4000-8000-000000000001", "name": "Quiet focus", "definition": "Spaces where individual concentration is the dominant expectation.", "color": "#65758b" },
    { "id": "30000000-0000-4000-8000-000000000002", "name": "Collaborative", "definition": "Spaces that support conversation, shared work, or informal group activity.", "color": "#b76845" },
    { "id": "30000000-0000-4000-8000-000000000003", "name": "Restorative", "definition": "Spaces where natural light, plants, views, or separation from routine activity support a mental reset.", "color": "#66875a" }
  ],
