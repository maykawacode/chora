{
  "name": "chora",
  "productName": "Chora",
  "version": "0.1.0-beta.7",
  "private": true,
  "description": "Spatial reasoning for qualitative data",
  "main": "./out/main/index.js",
  "author": "Matt Mayfield",
  "copyright": "Copyright © 2026 Matt Mayfield",
  "license": "MIT",
  "homepage": "https://github.com/maykawacode/chora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maykawacode/chora.git"
  },
  "bugs": {
    "url": "https://github.com/maykawacode/chora/issues"
  },
  "scripts": {
    "electron:install": "install-electron --no",
    "dev": "npm run electron:install && electron-vite dev",
    "build": "electron-vite build",
    "preview": "npm run electron:install && electron-vite preview",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts",
    "web:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON build/checkWebOutput.mts",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "lint": "eslint src",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run knip && npm test",
    "dist": "npm run build && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "svgcanvas": "^2.6.0",
    "trix": "^2.1.19",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.mayfield.chora",
    "productName": "Chora",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "resources/build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/examples",
        "to": "examples",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/help",
        "to": "help",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "icon": "resources/build/icon.icns",
      "minimumSystemVersion": "12.0.0",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "resources/build/entitlements.mac.plist",
      "entitlementsInherit": "resources/build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  }
}
